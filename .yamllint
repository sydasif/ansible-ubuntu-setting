---
extends: default

ignore: |
  .venv/
  .git/
  roles/*/files/*

rules:
  # Flow mappings/jinja braces: allow 0 (flow map) or 1 (jinja {{ var }}).
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 0

  # Long URLs and generated config lines exceed 80 chars by design.
  line-length:
    max: 160

  # Playbooks/roles do not consistently use a leading document marker.
  document-start: disable

  # The repo uses Ansible's native yes/no booleans in several places.
  truthy:
    check-keys: false
    allowed-values:
      - "true"
      - "false"
      - "yes"
      - "no"
      - "on"
      - "off"

  # Comments must have a space after the marker (ansible-lint requirement).
  comments:
    require-starting-space: true
    min-spaces-from-content: 1

  # Indented nested comments are allowed (ansible-lint requirement).
  comments-indentation: false

  # Octal values must be explicit (ansible-lint requirement).
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
